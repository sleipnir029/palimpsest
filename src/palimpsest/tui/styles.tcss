/* Scriptorium chat TUI — ink-on-parchment. Colours come from the registered
   SCRIPTORIUM theme (app.py) as $background/$foreground/$primary/$secondary/$accent. */

Screen {
    background: $background;
    color: $foreground;
}

#topbar {
    dock: top;
    height: 1;
    padding: 0 2;
    color: $accent;
    text-style: bold;
    background: $background;
}

/* The scrolling manuscript: per-message widgets, breathing room on the sides. */
#log {
    height: 1fr;
    padding: 1 2;
    background: $background;
    scrollbar-size-vertical: 1;
    scrollbar-color: $secondary;
    scrollbar-background: $background;
}

/* User line: the fresh hand, copper + bold, a blank line above to separate turns. */
.msg-user {
    color: $primary;
    text-style: bold;
    margin: 1 0 0 0;
}

/* Agent reply: the bright top layer (markdown), a blank line below it. The Markdown
   widget ships a built-in `padding: 0 2 0 2`; zero it so the reply's left edge lines up
   under the user's `❯`, with the traces one step further in (their margin below). */
.msg-agent {
    margin: 0 0 1 0;
    padding: 0;
}

/* Tool traces: the faded underwriting showing through, indented under the turn. Now a
   Collapsible per tool — strip its default surface card (border-top + surface bg +
   padding) back to a flat sepia line so it reads as underwriting, not a panel. */
.trace {
    color: $secondary;
    margin: 0 0 0 2;
}

.trace-error {
    color: $error;
    margin: 0 0 0 2;
}

Collapsible.trace, Collapsible.trace-error {
    background: $background;
    border-top: none;
    padding: 0;
    height: auto;
}

Collapsible.trace > CollapsibleTitle {
    color: $secondary;
    padding: 0;
}

Collapsible.trace-error > CollapsibleTitle {
    color: $error;
    padding: 0;
}

/* Expanded body: indented one step under its title, faded. */
Collapsible.trace > Contents,
Collapsible.trace-error > Contents {
    padding: 0 0 0 2;
    color: $secondary;
}

#dockbottom {
    dock: bottom;
    height: auto;
    background: $background;
}

/* Slash-command autocomplete: a framed list above the input, highlighted row in
   parchment, the rest sepia. Shown only while typing a /command. */
#cmdmenu {
    height: auto;
    max-height: 12;
    margin: 0 1;
    padding: 0 1;
    color: $secondary;
    background: $panel;
    border: round $secondary;
}

/* The empty-screen welcome hint. */
.welcome {
    margin: 1 0 0 2;
    color: $secondary;
}

/* Framed input — rounded copper border, gold on focus; the border carries the
   "ask" title and a one-line hint so the chrome itself does the signposting. */
#prompt {
    height: auto;        /* grow with content (multi-line composing) … */
    min-height: 1;
    max-height: 12;      /* … then lock and scroll internally past ~10 lines */
    margin: 0 1;
    padding: 0 1;
    border: round $primary;
    border-title-color: $secondary;
    border-subtitle-color: $secondary;
    background: $surface;
    color: $foreground;
}

#prompt:focus {
    border: round $accent;
}

/* Quiet footer: the three model roles + live spend, sepia so it recedes. */
#status {
    height: 1;
    padding: 0 2;
    color: $secondary;
    background: $background;
}
