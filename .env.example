# palimpsest — environment template. Copy to .env (gitignored) and fill what you need.
# `.env` is loaded by dotenv at startup. Nothing here is committed.

# ─────────────────────────────────────────────────────────────────────────────
# Core runtime (the agent + pipeline)
# ─────────────────────────────────────────────────────────────────────────────
# DeepSeek — the default runtime LLM (T50). Already funded.
#   Get: https://platform.deepseek.com → API keys. ~$2 min top-up. Cheapest cloud.
DEEPSEEK_API_KEY=

# Anthropic — fallback + the authoritative Claude tier in the T72 benchmark.
#   Get: https://console.anthropic.com → API keys. $5 min prepaid.
#   (Drained during T49/T51 — top up before running the Claude rows.)
ANTHROPIC_API_KEY=

# RunPod — cloud GPU for the 5 parsers (not needed for the LLM benchmark).
#   Get: https://runpod.io → Settings → API keys.
RUNPOD_API_KEY=
RUNPOD_TEMPLATE_DOCLING=
RUNPOD_TEMPLATE_MINERU=
RUNPOD_TEMPLATE_CHANDRA=
RUNPOD_TEMPLATE_DOTS=
RUNPOD_TEMPLATE_PADDLE=

# ═════════════════════════════════════════════════════════════════════════════
# T72 — LLM breadth-matrix benchmark (experiments/llm_matrix.py)
# A spec is SKIPPED until BOTH its key AND its model id are set. Leave blank to skip.
# Prices are USD per 1M tokens; leave blank to record tokens with a blank cost column.
# ═════════════════════════════════════════════════════════════════════════════

# ── OpenRouter — the gateway for cloud breadth (ONE key covers GPT/Qwen/Llama/…) ──
#   Get: https://openrouter.ai → Keys. $5 min credit (5.5% purchase fee, no per-token
#   markup EXCEPT Claude is 2x — so Claude runs direct via ANTHROPIC_API_KEY above).
#   Free models exist: append ':free' to a slug (20 req/min, 50/day; 1000/day after $5).
#   Verify exact slugs at https://openrouter.ai/models before running.
OPENROUTER_API_KEY=
#
# WHY THESE MODELS (the OpenRouter tier is a *principled* sample, not arbitrary):
# The matrix already covers, via direct providers, the closed labs Anthropic
# (Opus/Sonnet/Haiku) + DeepSeek (pro/flash) and Google (gemini-3.5-flash, free). These
# OpenRouter rows fill the families those miss + carry the strict-output arm (Part C —
# only OpenAI-compatible endpoints honour response_format). Slugs verified live
# 2026-06-20; gpt-5.1/gpt-5-mini and qwen3-235b/qwen-2.5-7b are STALE — refreshed below.
#
#   OR_OPENAI_MODEL       — OpenAI is the 3rd major *closed frontier* lab; gpt-5.4 = the
#                           current cost-quality anchor (gpt-5.5 is the 2x-pricier ceiling).
#   OR_OPENAI_MINI_MODEL  — OpenAI's cheap tier → a *within-OpenAI* scaling point.
#   OR_QWEN_MODEL         — Qwen is the strongest OPEN-weight family in 2026; qwen3.7-plus
#                           is the cost-value 1M-ctx flagship (open-model challenger).
#   OR_GEMINI_LITE_MODEL  — gemini-3.1-flash-lite = ultra-cheap baseline AND the Gemini in
#                           the strict arm (free-tier Gemini below is raw-only); pairs with
#                           gemini-3.5-flash for a within-Gemini scaling point.
# (Round-2 pool, add only if Stage 1 has no clear winner: mistralai/mistral-large-2512,
#  x-ai/grok-4.3, qwen/qwen3.7-max, and — verify first — z-ai/glm-5.2, minimax/minimax-m3.
#  If you change a slug, update its price in experiments/llm_matrix.py.)
OR_OPENAI_MODEL=openai/gpt-5.4
OR_OPENAI_MINI_MODEL=openai/gpt-5.4-mini
OR_QWEN_MODEL=qwen/qwen3.7-plus
OR_GEMINI_LITE_MODEL=google/gemini-3.1-flash-lite

# ── Google Gemini — FREE tier, no card (Flash models; ~1500 req/day) ──
#   Get: https://aistudio.google.com → Get API key. Recorded as €0 (free-tier floor).
GEMINI_API_KEY=
GEMINI_MODEL=                # e.g. gemini-3.5-flash  (Flash/Flash-Lite are free; Pro is not)

# ── Local floor — free, on the M1 (8GB → 3B Q4 model is the realistic ceiling) ──
#   LM Studio (recommended, MLX-accelerated): install, download an MLX 3B model, start
#   its server (Developer tab → Start). Default base_url below is LM Studio's :1234.
#     suggested model: qwen2.5-3b-instruct (MLX) or llama-3.2-3b-instruct (MLX)
#   Ollama alternative: `ollama serve`, then set LOCAL_BASE_URL=http://localhost:11434/v1
#     suggested model: qwen2.5:3b  or  llama3.2:3b
LOCAL_MODEL=                 # e.g. qwen2.5-3b-instruct  (must match the loaded model id)
LOCAL_BASE_URL=              # blank → http://localhost:1234/v1 (LM Studio)

# ── Optional extra free tiers (OpenAI-compatible; wire via OpenRouter or add a spec) ──
#   Groq   https://console.groq.com   (Llama 70B, fast, free)   base: api.groq.com/openai/v1
#   Cerebras https://cloud.cerebras.ai (1M tok/day free)         base: api.cerebras.ai/v1
#   Mistral https://console.mistral.ai (~1B tok/mo free)         base: api.mistral.ai/v1
