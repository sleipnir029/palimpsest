# palimpsest environment template. Copy to .env (gitignored) and fill what you need.
# Only DEEPSEEK_API_KEY is required to try the agent on the bundled example papers.
# If a key is missing at startup, the TUI asks for it and saves it to workspace/.env.

# --- LLMs --------------------------------------------------------------------
# DeepSeek: default model for the agent loop and for extraction (deepseek-v4-flash,
# called through DeepSeek's Anthropic-compatible endpoint). https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Anthropic (optional): Claude Sonnet/Haiku for the agent or extraction.
#   /use orchestration anthropic   or   /use extraction anthropic
ANTHROPIC_API_KEY=

# Gemini (optional, extraction only).   /use extraction gemini
GEMINI_API_KEY=
GEMINI_MODEL=                # e.g. gemini-3.5-flash

# OpenRouter (optional, extraction only; never drives the agent loop).   /use extraction openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=            # default openai/gpt-4o-mini
OPENROUTER_PRICE_IN=         # USD per 1M input tokens; blank -> metered at conservative Sonnet rates
OPENROUTER_PRICE_OUT=        # USD per 1M output tokens

# Your own model (lab / institute server, nothing leaves your network).
#   Anthropic-compatible endpoint: can run the agent AND extraction.
#     /use orchestration local-anthropic <model>   /use extraction local-anthropic <model>
LOCAL_ANTHROPIC_BASE_URL=    # e.g. http://gpu-node.your-institute:8000
LOCAL_ANTHROPIC_MODEL=
LOCAL_ANTHROPIC_API_KEY=     # only if your server needs one
#   OpenAI-compatible endpoint (/v1/chat/completions): extraction only.
#     /use extraction local-openai <model>
LOCAL_OPENAI_BASE_URL=       # e.g. http://localhost:8000/v1
LOCAL_OPENAI_MODEL=
LOCAL_OPENAI_API_KEY=
# Cost of your server per 1M tokens in USD, for the budget meter. Set both to 0 for
# free local inference; left blank, calls are metered at Claude Sonnet rates.
LOCAL_PRICE_IN=
LOCAL_PRICE_OUT=

# --- Parsing new PDFs (cloud GPU) ---------------------------------------------
# Not needed for the bundled example papers: their parser outputs ship in cache/.
# For your own PDFs, build the parser images in docker/ and create RunPod templates.
RUNPOD_API_KEY=
RUNPOD_TEMPLATE_DOCLING=
RUNPOD_TEMPLATE_MINERU=
RUNPOD_TEMPLATE_CHANDRA=
RUNPOD_TEMPLATE_DOTS=
RUNPOD_TEMPLATE_PADDLE=

# --- Workspace -----------------------------------------------------------------
# Where the agent may write (notebooks, notes, data). Defaults to ./workspace.
# PALIMPSEST_WORKSPACE=
